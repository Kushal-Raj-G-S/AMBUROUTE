# Free public token from https://account.mapbox.com (starts with pk.)
MAPBOX_TOKEN=pk.your_public_token_here

# --- service hardening (all optional) ---
# API_KEY=change-me                 # if set, write endpoints (/hospitals/*/beds, /feedback, /decision) need the X-API-Key header
# CORS_ORIGINS=https://dispatch.example.org
# MAX_AMBULANCES=200                # per /assign request
# RATE_LIMIT_PER_MIN=0              # per client address; 0 = off
# STALE_MINUTES=15                  # bed reports older than this are flagged
# STATE_PATH=/data/state.json       # keeps bed state and learned corrections across restarts
# SHADOW_LOG=/data/shadow.jsonl     # dispatcher decisions next to recommendations (no patient data)
# LOG_LEVEL=INFO
